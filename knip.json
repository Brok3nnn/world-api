{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["scripts/**/*.mjs"]
    },
    "apps/web": {
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    "apps/gateway": {
      "project": ["src/**/*.ts"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreIssues": {
    "apps/web/src/components/ui/**": ["exports", "types"]
  }
}
