# dependencies
node_modules/

# build output: only at the places a tool writes it, so that no source folder with one of
# these names is ever ignored (`pnpm structure:check` fails if a source file is ignored)
.next/
coverage/
/apps/*/out/
/apps/*/build/
/apps/*/dist/
/packages/*/dist/

# generated by tooling
*.tsbuildinfo
next-env.d.ts

# environment files; only the example is tracked (see docs/architecture/operations.md)
.env*
!.env.example

# local
.DS_Store
*.pem
*.log
.vercel
.idea/
.vscode/
