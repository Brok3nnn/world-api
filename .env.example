# Configuration template. Copy it to `.env` and fill in the values; `.env` is never committed.
#
# Every variable an app reads is listed here with a comment and no real value, and has a row in
# docs/architecture/operations.md. Checks and tests run with an empty environment; only the local
# gateway and the commands that fetch live sources need a value.

# Required by `pnpm dev:gateway`, the proofs and the response recorder. How a source's operator
# can reach whoever runs this code, sent in the User-Agent of every live fetch: an https URL or
# an email address, such as https://example.com/contact or you@example.com. Some sources, such
# as api.weather.gov, ask every client for one.
USER_AGENT_CONTACT=

# Least severe log level the gateway writes: debug, info, warn or error. Default: info.
# LOG_LEVEL=info
